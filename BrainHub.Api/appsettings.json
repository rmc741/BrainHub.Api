{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "BrainHubBackContext": "Data Source=BrainHubDatabase.db"
  },

  "Jwt": {
    "Issuer": "BrainHub.Api",
    "Audience": "BrainHub.WebSite",
    "SecretKey": "DEV_ONLY_CHANGE_THIS_SECRET_KEY_WITH_AT_LEAST_32_CHARS",
    "ExpirationInMinutes": 120
  }
}
